# ===========================================
# Webex Bot Environment Variables
# ===========================================
# Copy this file to .env and replace with your actual values

# ----- Webex Bot Configuration -----
# Your Webex bot token from developer.webex.com
BOTTOKEN="your-webex-bot-token-here"

# ----- Webhook Configuration (Optional) -----
# If you want to use webhooks instead of websockets, set these:
# Your public webhook URL (e.g., from ngrok)
WEBHOOKURL=https://your-domain.ngrok-free.dev

# Port for the bot to listen on
PORT=3001

# ----- n8n Webhook URLs -----
# Main webhook URL for test failure notifications
N8N_WEBHOOK_URL="http://localhost:5678/webhook/your-webhook-id"

# Optional: Separate webhooks for different actions
# N8N_JIRA_WEBHOOK_URL="http://localhost:5678/webhook/jira-webhook-id"
# N8N_RESET_WEBHOOK_URL="http://localhost:5678/webhook/reset-webhook-id"
# N8N_FIX_WEBHOOK_URL="http://localhost:5678/webhook/fix-webhook-id"
